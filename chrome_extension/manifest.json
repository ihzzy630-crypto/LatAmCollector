{
  "manifest_version": 3,
  "name": "LatAmCollector Brazil Helper",
  "version": "0.8.0",
  "description": "Capture public Shopee and SHEIN Brazil product lists, sales and reviews into the local LatAmCollector platform.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://shopee.com.br/*",
    "https://*.shopee.com.br/*",
    "https://br.shein.com/*",
    "https://*.br.shein.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LatAmCollector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*", "https://br.shein.com/*", "https://*.br.shein.com/*"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*", "https://br.shein.com/*", "https://*.br.shein.com/*"],
      "js": ["queue_core.js", "review_core.js", "bridge.js", "review_driver.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://127.0.0.1:8765/*"],
      "js": ["local_bridge.js"],
      "run_at": "document_start"
    }
  ]
}

